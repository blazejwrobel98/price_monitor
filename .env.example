# Katalog danych (SQLite domyślnie: `{DATA_DIR}/prices.db`)
DATA_DIR=./data

# Port backendu przy `python -m price_monitor` (domyślnie 8017; zmieniaj tylko razem z PRICE_MONITOR_API_PROXY w frontendzie)
# PRICE_MONITOR_PORT=9000

# Wyłącza harmonogram (np. testy / debug)
SCHEDULER_ENABLED=true

# Opcjonalnie pełny URL bazy (nadpisuje domyślny plik SQLite)
# DATABASE_URL=sqlite:////absolute/path.db

# Timeout HTTP przy pobieraniu stron (sekundy)
REQUEST_TIMEOUT_SECONDS=25

# --- Frontend (Vite): tylko gdy zmieniasz port — w frontend/.env lub w shellu; musi = PRICE_MONITOR_PORT ---
# PRICE_MONITOR_API_PROXY=http://127.0.0.1:9000

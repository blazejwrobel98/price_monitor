# Katalog danych (SQLite domyślnie: `{DATA_DIR}/prices.db`)
DATA_DIR=./data

# Wyłącza harmonogram (np. testy / debug)
SCHEDULER_ENABLED=true

# Opcjonalnie pełny URL bazy (nadpisuje domyślny plik SQLite)
# DATABASE_URL=sqlite:////absolute/path.db

# Timeout HTTP przy pobieraniu stron (sekundy)
REQUEST_TIMEOUT_SECONDS=25
